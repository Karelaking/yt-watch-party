NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# -------------------------------------------------------------
# NeonDB PostgreSQL (Prisma ORM)
# -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"


# -------------------------------------------------------------
# Redis (Upstash Redis REST / TLS URL)
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"
# Optional fallback direct REDIS_URL (auto-derived if Upstash credentials are provided)
REDIS_URL="redis://localhost:6379"

# -------------------------------------------------------------
# MongoDB (Mongoose)
# -------------------------------------------------------------
MONGODB_URL="mongodb+srv://user:pass@cluster.mongodb.net/watchparty"

# -------------------------------------------------------------
# Clerk Authentication
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
